<?xml version="1.0"?>
<!--
  NC Zoning District Guide - Input Bindings
  Processed by: Input Loader (RED4ext plugin by jackhumbert)
  https://github.com/jackhumbert/cyberpunk2077-input-loader

  Defines NCZDG_ToggleGuide, bound to ' (IK_SingleQuote) by default.

  MODIFIERS ARE NO LONGER DECLARED HERE. This file used to register NCZDG_ModShift /
  NCZDG_ModAlt / NCZDG_ModCtrl as three actions of their own, purely so the input listener
  could observe whether they were held. The reasoning was that IsShiftDown() and friends
  live on inkInputEvent, a UI event a gameplay ListenerAction callback cannot reach. That
  much is true. The conclusion was not: Codeware's CallbackSystem event n"Input/Key"
  delivers a KeyInputEvent, which is not a UI event and exposes GetKey(), GetAction(),
  IsShiftDown(), IsControlDown() and IsAltDown(). The modifier is read there now (see
  ModifierWatch.reds), so it can be ANY key rather than one of three, and this file
  registers one action instead of four.

  The overridableUI attribute names the 'openGuideKey' field on the NCZDGKeybind redscript
  class, and it is ALSO the RCF schema row key. RCF's bundled DVRCFInput plugin writes the
  player's chosen key into the input system through that name, so all three spellings must
  match: this attribute, the field, and NCZDG_KeyOpenKey() in RCFAdapter.reds. A mismatch
  fails silently, with no error in any log.

  Without RCF the binding stays on the default below and cannot be rebound. Without Input
  Loader this file is never read, no action registers, and the listener is inert.
-->
<bindings>
  <context name="NCZDistrictGuide">
    <action name="NCZDG_ToggleGuide" map="NCZDG_ToggleGuideMap"/>
  </context>

  <context name="Exploration" append="true">
    <include name="NCZDistrictGuide"/>
  </context>
  <context name="Combat" append="true">
    <include name="NCZDistrictGuide"/>
  </context>
  <context name="VehicleDriveBase" append="true">
    <include name="NCZDistrictGuide"/>
  </context>
  <context name="VehiclePassenger" append="true">
    <include name="NCZDistrictGuide"/>
  </context>

  <mapping name="NCZDG_ToggleGuideMap" type="Button">
    <button id="IK_SingleQuote" overridableUI="openGuideKey"/>
  </mapping>
</bindings>
